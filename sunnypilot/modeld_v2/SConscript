import glob
import json
import os
from pathlib import Path
from SCons.Script import Value
from openpilot.selfdrive.modeld.tinygrad_helpers import (
  format_tinygrad_env,
  get_runtime_flags_from_compile_env,
  get_tinygrad_available_devices,
  get_tinygrad_compile_env,
  get_tinygrad_compile_image_flag,
  write_tinygrad_compiled_flags,
)

Import('env', 'arch')
lenv = env.Clone()
tinygrad_files = ["#"+x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**", recursive=True, root_dir=env.Dir("#").abspath) if 'pycache' not in x]

# Get model metadata
PC = not os.path.isfile('/TICI')
if PC:
  inputs = tinygrad_files + [File(Dir("#sunnypilot/modeld_v2").File("install_models_pc.py").abspath)]
  outputs = []
  model_dir = Dir("models").abspath
  cmd = f'python3 {Dir("#sunnypilot/modeld_v2").abspath}/install_models_pc.py {model_dir}'

  for model_name in ['supercombo', 'driving_vision', 'driving_off_policy', 'driving_policy']:
    if File(f"models/{model_name}.onnx").exists():
        inputs.append(File(f"models/{model_name}.onnx"))
        inputs.append(File(f"models/{model_name}_tinygrad.pkl"))
        outputs.append(File(f"models/{model_name}_metadata.pkl"))
  if outputs:
    lenv.Command(outputs, inputs, cmd)

tg_compile_env = get_tinygrad_compile_env(arch, get_tinygrad_available_devices())
tg_runtime_flags = get_runtime_flags_from_compile_env(tg_compile_env)
tg_flags = format_tinygrad_env(tg_compile_env, include_home=arch == 'Darwin')
image_flag = get_tinygrad_compile_image_flag(arch)

def do_write_tg_compiled_flags(target, source, env):
  write_tinygrad_compiled_flags(Path(str(target[0])), tg_runtime_flags)

compiled_flags_node = lenv.Command(
  File("models/tg_compiled_flags.json").abspath,
  tinygrad_files + [Value(json.dumps(tg_compile_env, sort_keys=True))],
  do_write_tg_compiled_flags,
)

def tg_compile(flags, model_name):
  pythonpath_string = 'PYTHONPATH="${PYTHONPATH}:' + env.Dir("#tinygrad_repo").abspath + '"'
  fn = File(f"models/{model_name}").abspath
  out = fn + "_tinygrad.pkl"

  return lenv.Command(
    out,
    [fn + ".onnx"] + tinygrad_files + [compiled_flags_node],
    f'{pythonpath_string} {flags} {image_flag} python3 {Dir("#tinygrad_repo").abspath}/examples/openpilot/compile3.py {fn}.onnx {out}'
  )

# Compile models
for model_name in ['supercombo', 'driving_vision', 'driving_off_policy', 'driving_policy']:
  if File(f"models/{model_name}.onnx").exists():
    tg_compile(tg_flags, model_name)

script_files = [File("warp.py"), File(Dir("#selfdrive/modeld").File("compile_warp.py").abspath)]
pythonpath_string = 'PYTHONPATH="${PYTHONPATH}:' + env.Dir("#tinygrad_repo").abspath + ':' + env.Dir("#").abspath + '"'
compile_warp_cmd = f'{pythonpath_string} {tg_flags} python3 -m sunnypilot.modeld_v2.warp'

from openpilot.common.transformations.camera import _ar_ox_fisheye, _os_fisheye
warp_targets = []
for cam in [_ar_ox_fisheye, _os_fisheye]:
  w, h = cam.width, cam.height
  for bl in [2, 5]:
    warp_targets.append(File(f"models/warp_{w}x{h}_b{bl}_tinygrad.pkl").abspath)
lenv.Command(warp_targets, tinygrad_files + script_files + [compiled_flags_node], compile_warp_cmd)
